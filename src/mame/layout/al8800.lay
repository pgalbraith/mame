	<group name="panel">
		<element ref="art"><bounds x="0" y="0" width="3180" height="1387" /></element>

		<!-- status LEDs -->
		<element ref="t_inte"><bounds x="441" y="199" width="110" height="32" /></element>
		<element name="3.0" ref="led"><bounds x="474" y="238" width="44" height="44" /></element>
		<element ref="t_prot"><bounds x="557" y="199" width="110" height="32" /></element>
		<element name="3.1" ref="led"><bounds x="590" y="238" width="44" height="44" /></element>
		<repeat count="8">
			<param name="n" start="7" increment="-1" />
			<param name="lx" start="673" increment="116" />
			<param name="x" start="706" increment="116" />
			<element ref="t_s~n~"><bounds x="~lx~" y="199" width="110" height="32" /></element>
			<element name="2.~n~" ref="led"><bounds x="~x~" y="238" width="44" height="44" /></element>
		</repeat>
		<element ref="t_status"><bounds x="1034" y="300" width="200" height="28" /></element>

		<element ref="t_wait"><bounds x="441" y="436" width="110" height="32" /></element>
		<element name="3.2" ref="led"><bounds x="474" y="475" width="44" height="44" /></element>
		<element ref="t_hlda"><bounds x="557" y="436" width="110" height="32" /></element>
		<element name="3.3" ref="led"><bounds x="590" y="475" width="44" height="44" /></element>

		<!-- data LEDs, over A7-A0 -->
		<element ref="t_d7"><bounds x="1863" y="199" width="110" height="32" /></element>
		<element name="1.7" ref="led"><bounds x="1896" y="238" width="44" height="44" /></element>
		<element ref="t_d6"><bounds x="1975" y="199" width="110" height="32" /></element>
		<element name="1.6" ref="led"><bounds x="2008" y="238" width="44" height="44" /></element>
		<element ref="t_d5"><bounds x="2143" y="199" width="110" height="32" /></element>
		<element name="1.5" ref="led"><bounds x="2176" y="238" width="44" height="44" /></element>
		<element ref="t_d4"><bounds x="2255" y="199" width="110" height="32" /></element>
		<element name="1.4" ref="led"><bounds x="2288" y="238" width="44" height="44" /></element>
		<element ref="t_d3"><bounds x="2367" y="199" width="110" height="32" /></element>
		<element name="1.3" ref="led"><bounds x="2400" y="238" width="44" height="44" /></element>
		<element ref="t_d2"><bounds x="2535" y="199" width="110" height="32" /></element>
		<element name="1.2" ref="led"><bounds x="2568" y="238" width="44" height="44" /></element>
		<element ref="t_d1"><bounds x="2647" y="199" width="110" height="32" /></element>
		<element name="1.1" ref="led"><bounds x="2680" y="238" width="44" height="44" /></element>
		<element ref="t_d0"><bounds x="2759" y="199" width="110" height="32" /></element>
		<element name="1.0" ref="led"><bounds x="2792" y="238" width="44" height="44" /></element>

		<!-- address LEDs and address/data switches: A15 on its own, then octal groups of three -->
		<element ref="t_sense"><bounds x="544" y="666" width="200" height="28" /></element>
		<element ref="t_a15"><bounds x="799" y="436" width="110" height="32" /></element>
		<element name="0.15" ref="led"><bounds x="832" y="475" width="44" height="44" /></element>
		<element ref="t_n15"><bounds x="799" y="666" width="110" height="28" /></element>
		<element ref="toggle" inputtag="SWITCHES" inputmask="0x8000"><bounds x="832" y="696" width="44" height="120" /></element>
		<repeat count="5">
			<param name="gbit" start="14" increment="-3" />
			<param name="gmask" start="0x4000" rshift="3" />
			<param name="glx" start="967" increment="392" />
			<param name="gx" start="1000" increment="392" />
			<repeat count="3">
				<param name="n" start="~gbit~" increment="-1" />
				<param name="mask" start="~gmask~" rshift="1" />
				<param name="lx" start="~glx~" increment="112" />
				<param name="x" start="~gx~" increment="112" />
				<element ref="t_a~n~"><bounds x="~lx~" y="436" width="110" height="32" /></element>
				<element name="0.~n~" ref="led"><bounds x="~x~" y="475" width="44" height="44" /></element>
				<element ref="t_n~n~"><bounds x="~lx~" y="666" width="110" height="28" /></element>
				<element ref="toggle" inputtag="SWITCHES" inputmask="~mask~"><bounds x="~x~" y="696" width="44" height="120" /></element>
			</repeat>
		</repeat>
		<element ref="t_data"><bounds x="2912" y="752" width="120" height="28" /></element>
		<element ref="t_address"><bounds x="2900" y="832" width="144" height="28" /></element>

		<!-- power switch, for show -->
		<element ref="t_off"><bounds x="231" y="912" width="110" height="30" /></element>
		<element ref="power"><bounds x="264" y="911" width="44" height="120" /></element>
		<element ref="t_on"><bounds x="231" y="1014" width="110" height="30" /></element>

		<!-- control switch labels -->
		<element ref="t_stop"><bounds x="774" y="890" width="160" height="30" /></element>
		<element ref="t_run"><bounds x="774" y="986" width="160" height="30" /></element>
		<element ref="t_single"><bounds x="1002" y="860" width="160" height="30" /></element>
		<element ref="t_step"><bounds x="1002" y="890" width="160" height="30" /></element>
		<!-- the driver sets panel_8800b to 1 on the 8800b, which adds SLOW and calls CLR EXT CLR -->
		<element name="panel_8800b" ref="t_slow"><bounds x="1002" y="986" width="160" height="30" /></element>
		<element ref="t_examine"><bounds x="1230" y="890" width="160" height="30" /></element>
		<element ref="t_examine"><bounds x="1230" y="986" width="160" height="30" /></element>
		<element ref="t_next"><bounds x="1230" y="1014" width="160" height="30" /></element>
		<element ref="t_deposit"><bounds x="1458" y="890" width="160" height="30" /></element>
		<element ref="t_deposit"><bounds x="1458" y="986" width="160" height="30" /></element>
		<element ref="t_next"><bounds x="1458" y="1014" width="160" height="30" /></element>
		<element ref="t_reset"><bounds x="1686" y="890" width="160" height="30" /></element>
		<element name="panel_8800b" ref="t_clr"><bounds x="1686" y="986" width="160" height="30" /></element>
		<element ref="t_protect"><bounds x="1914" y="890" width="160" height="30" /></element>
		<element ref="t_unprotect"><bounds x="1914" y="986" width="160" height="30" /></element>
		<element ref="t_aux"><bounds x="2142" y="890" width="160" height="30" /></element>
		<element ref="t_aux"><bounds x="2370" y="890" width="160" height="30" /></element>

		<!-- control switches: each position is its own clickable half -->
		<repeat count="8">
			<param name="i" start="0" increment="1" />
			<param name="upmask" start="0x0001" lshift="2" />
			<param name="dnmask" start="0x0002" lshift="2" />
			<param name="x" start="832" increment="228" />
			<param name="hx" start="828" increment="228" />
			<element name="lever~i~" ref="lever"><bounds x="~x~" y="891" width="44" height="120" /></element>
			<element ref="hit" inputtag="CONTROLS" inputmask="~upmask~"><bounds x="~hx~" y="887" width="52" height="64" /></element>
			<element ref="hit" inputtag="CONTROLS" inputmask="~dnmask~"><bounds x="~hx~" y="951" width="52" height="64" /></element>
		</repeat>
	</group>

	<view name="Terminal and Front Panel">
		<screen index="0"><bounds x="0" y="0" width="3180" height="2385" /></screen>
		<group ref="panel"><bounds x="0" y="2405" width="3180" height="1387" /></group>
	</view>

	<view name="Front Panel">
		<group ref="panel"><bounds x="0" y="0" width="3180" height="1387" /></group>
	</view>

</mamelayout>
