<mamelayout version="2">

	<!--
	The MITS Altair 8800 front panel, drawn from straight-on photographs of
	surviving machines:
	- https://commons.wikimedia.org/wiki/File:CPU_Altair_8800.jpg (an original,
	  with the aluminium name strip)
	- https://commons.wikimedia.org/wiki/File:MITS_Altair_8800_Front_Panel.jpg
	  (restored, clearest for the layout of lines and labels)

	Everything is in the coordinates of the "art" element: 3180 by 1387, the
	blue frame included, with the dark panel inside it from (64,52) to
	(3116,1315). Address columns are 112 apart inside an octal group and 168
	between groups, A15 at x=854 through A0 at x=2814; the data LEDs sit over
	A7-A0. The static artwork is one SVG image; LEDs, switches and labels are
	drawn over it.

	Labels are drawn twice, a fraction apart, because the panel's lettering is
	bold and the layout font has no bold.

	LED outputs are named row.bit by the driver: row 0 address, row 1 data,
	row 2 the 8080 status latch, row 3 INTE/PROT/WAIT/HLDA. Their state is a
	brightness level, 0 (off) to 4 (full). lever0-lever7 are the control
	switch positions: 0 centre, 1 up, 2 down.
	-->

	<element name="art">
		<image><data><![CDATA[
			<?xml version="1.0" encoding="UTF-8" standalone="no"?>
			<svg xmlns:svg="http://www.w3.org/2000/svg" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 3180 1387" width="3180" height="1387">
				<defs>
					<linearGradient id="frame" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1387">
						<stop offset="0" stop-color="#5a90cc" />
						<stop offset="1" stop-color="#3a6aa3" />
					</linearGradient>
					<linearGradient id="metal" gradientUnits="userSpaceOnUse" x1="0" y1="1086" x2="0" y2="1315">
						<stop offset="0" stop-color="#e8e8e4" />
						<stop offset="0.15" stop-color="#d2d2ce" />
						<stop offset="0.6" stop-color="#bbbbb7" />
						<stop offset="1" stop-color="#9e9e9a" />
					</linearGradient>
				</defs>

				<!-- frame and panel -->
				<rect x="0" y="0" width="3180" height="1387" fill="url(#frame)" />
				<rect x="0" y="0" width="3180" height="6" fill="#86b2e2" />
				<rect x="56" y="44" width="3068" height="1279" fill="#2d5688" />
				<rect x="64" y="52" width="3052" height="1263" fill="#363b3b" />

				<!-- aluminium name strip -->
				<rect x="64" y="1086" width="3052" height="229" fill="url(#metal)" />
				<rect x="64" y="1086" width="3052" height="4" fill="#f6f6f2" />
				<g fill="#ffffff" fill-opacity="0.16">
					<rect x="64" y="1112" width="3052" height="2" />
					<rect x="64" y="1151" width="3052" height="3" />
					<rect x="64" y="1197" width="3052" height="2" />
					<rect x="64" y="1243" width="3052" height="3" />
					<rect x="64" y="1289" width="3052" height="2" />
				</g>
				<g fill="#000000" fill-opacity="0.06">
					<rect x="64" y="1131" width="3052" height="2" />
					<rect x="64" y="1220" width="3052" height="3" />
					<rect x="64" y="1270" width="3052" height="2" />
				</g>

				<!-- MITS logo: a grey wedge behind a white box -->
				<polygon points="384,1286 488,1164 488,1286" fill="#8b8b87" stroke="#3b3b39" stroke-width="3" />
				<rect x="297" y="1196" width="140" height="56" fill="#f0f0ec" stroke="#1a1a1a" stroke-width="5" />
				<g fill="#1a1a1a">
					<rect x="314" y="1206" width="8" height="36" />
					<rect x="336" y="1206" width="8" height="36" />
					<rect x="314" y="1206" width="30" height="8" />
					<rect x="325" y="1206" width="8" height="24" />
					<rect x="352" y="1206" width="8" height="36" />
					<rect x="366" y="1206" width="26" height="8" />
					<rect x="375" y="1206" width="8" height="36" />
					<rect x="398" y="1206" width="24" height="8" />
					<rect x="398" y="1206" width="8" height="21" />
					<rect x="398" y="1220" width="24" height="8" />
					<rect x="414" y="1220" width="8" height="22" />
					<rect x="398" y="1234" width="24" height="8" />
				</g>

				<!-- ALTAIR 8800: black shapes, with their counters cut out in the strip's own gradient -->
				<g fill="#161616">
					<rect x="542" y="1172" width="80" height="106" rx="10" />
					<rect x="636" y="1172" width="24" height="106" />
					<rect x="636" y="1254" width="64" height="24" />
					<rect x="714" y="1172" width="74" height="24" />
					<rect x="739" y="1172" width="24" height="106" />
					<rect x="802" y="1172" width="80" height="106" rx="10" />
					<rect x="896" y="1172" width="24" height="106" />
					<rect x="934" y="1172" width="24" height="106" />
					<rect x="934" y="1172" width="76" height="64" rx="10" />
					<polygon points="966,1236 992,1236 1012,1278 986,1278" />
					<rect x="1062" y="1172" width="70" height="106" rx="16" />
					<rect x="1144" y="1172" width="70" height="106" rx="16" />
					<rect x="1226" y="1172" width="70" height="106" rx="16" />
					<rect x="1308" y="1172" width="70" height="106" rx="16" />
				</g>
				<g fill="url(#metal)">
					<rect x="566" y="1196" width="32" height="24" rx="3" />
					<rect x="566" y="1244" width="32" height="36" />
					<rect x="826" y="1196" width="32" height="24" rx="3" />
					<rect x="826" y="1244" width="32" height="36" />
					<rect x="958" y="1196" width="28" height="16" rx="3" />
					<rect x="1086" y="1196" width="22" height="17" rx="4" />
					<rect x="1086" y="1237" width="22" height="17" rx="4" />
					<rect x="1168" y="1196" width="22" height="17" rx="4" />
					<rect x="1168" y="1237" width="22" height="17" rx="4" />
					<rect x="1250" y="1196" width="22" height="58" rx="4" />
					<rect x="1332" y="1196" width="22" height="58" rx="4" />
				</g>

				<!-- COMPUTER -->
				<g fill="#161616">
					<rect x="1440" y="1213" width="52" height="65" rx="9" />
					<rect x="1502" y="1213" width="56" height="65" rx="9" />
					<rect x="1568" y="1213" width="66" height="65" rx="6" />
					<rect x="1644" y="1213" width="15" height="65" />
					<rect x="1644" y="1213" width="50" height="40" rx="7" />
					<rect x="1704" y="1213" width="54" height="65" rx="9" />
					<rect x="1768" y="1213" width="50" height="15" />
					<rect x="1785" y="1213" width="15" height="65" />
					<rect x="1828" y="1213" width="15" height="65" />
					<rect x="1828" y="1213" width="46" height="15" />
					<rect x="1828" y="1238" width="40" height="15" />
					<rect x="1828" y="1263" width="46" height="15" />
					<rect x="1884" y="1213" width="15" height="65" />
					<rect x="1884" y="1213" width="52" height="40" rx="7" />
					<polygon points="1906,1253 1922,1253 1938,1278 1922,1278" />
				</g>
				<g fill="url(#metal)">
					<rect x="1455" y="1228" width="40" height="35" />
					<rect x="1517" y="1228" width="26" height="35" rx="3" />
					<rect x="1583" y="1228" width="11" height="52" />
					<rect x="1608" y="1228" width="11" height="52" />
					<rect x="1659" y="1228" width="20" height="10" />
					<rect x="1719" y="1211" width="24" height="52" />
					<rect x="1899" y="1228" width="22" height="10" />
				</g>

				<!-- white panel lines -->
				<rect x="690" y="292" width="888" height="4" fill="#e6e6e2" />
				<g stroke="#e6e6e2" stroke-width="4" fill="none">
					<g stroke-dasharray="12 10">
						<path d="M 1918,292 V 428 M 2030,292 V 428 M 2198,292 V 428 M 2310,292 V 428 M 2422,292 V 428 M 2590,292 V 428 M 2702,292 V 428 M 2814,292 V 428" />
						<path d="M 854,528 V 658 M 1022,528 V 658 M 1134,528 V 658 M 1246,528 V 658 M 1414,528 V 658 M 1526,528 V 658 M 1638,528 V 658 M 1806,528 V 658" />
						<path d="M 1918,528 V 658 M 2030,528 V 658 M 2198,528 V 658 M 2310,528 V 658 M 2422,528 V 658 M 2590,528 V 658 M 2702,528 V 658 M 2814,528 V 658" />
					</g>
					<polyline points="752,680 800,680 836,810 1868,810 1868,770" />
					<path d="M 1872,810 H 2078 M 2150,810 H 2470 M 2542,810 H 2880 L 2912,790 H 3030" />
					<path d="M 806,824 H 902 M 974,824 H 1294 M 1366,824 H 1686 M 1758,824 H 2078 M 2150,824 H 2470 M 2542,824 H 3030" />
				</g>
			</svg>
		]]></data></image>
	</element>

	<element name="hit" defstate="0"><rect><color alpha="0" /></rect></element>

	<!-- LEDs: red domes, dark maroon when off -->

	<element name="led" defstate="0">
		<disk><color red="0.10" green="0.05" blue="0.05" /></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.36" green="0.06" blue="0.06" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.52" green="0.08" blue="0.07" /></disk>
		<disk state="2"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.70" green="0.11" blue="0.08" /></disk>
		<disk state="3"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.88" green="0.15" blue="0.10" /></disk>
		<disk state="4"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="1.00" green="0.24" blue="0.14" /></disk>
		<disk state="4"><bounds x="0.3" y="0.3" width="0.4" height="0.4" /><color red="1.00" green="0.55" blue="0.35" /></disk>
		<disk><bounds x="0.27" y="0.2" width="0.22" height="0.18" /><color red="1.0" green="1.0" blue="1.0" alpha="0.3" /></disk>
	</element>

	<!-- toggle switches: a black bushing with a short silver bat handle -->

	<element name="toggle" defstate="0">
		<rect><bounds x="0" y="0" width="44" height="120" /><color alpha="0" /></rect>
		<disk><bounds x="2" y="40" width="40" height="40" /><color red="0.07" green="0.07" blue="0.07" /></disk>
		<disk><bounds x="8" y="46" width="28" height="28" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect state="1"><bounds x="18" y="28" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="1"><bounds x="14" y="22" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<rect state="0"><bounds x="18" y="60" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="0"><bounds x="14" y="82" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
	</element>

	<!-- momentary control switches: 0 centre, 1 up, 2 down -->

	<element name="lever" defstate="0">
		<rect><bounds x="0" y="0" width="44" height="120" /><color alpha="0" /></rect>
		<disk><bounds x="2" y="40" width="40" height="40" /><color red="0.07" green="0.07" blue="0.07" /></disk>
		<disk><bounds x="8" y="46" width="28" height="28" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect state="1"><bounds x="18" y="28" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="1"><bounds x="14" y="22" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<rect state="2"><bounds x="18" y="60" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="2"><bounds x="14" y="82" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk state="0"><bounds x="13" y="51" width="18" height="18" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk state="1"><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
		<disk state="2"><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
	</element>

	<!-- the power switch is only drawn, turned on -->

	<element name="power">
		<rect><bounds x="0" y="0" width="44" height="120" /><color alpha="0" /></rect>
		<disk><bounds x="2" y="40" width="40" height="40" /><color red="0.07" green="0.07" blue="0.07" /></disk>
		<disk><bounds x="8" y="46" width="28" height="28" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect><bounds x="18" y="60" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk><bounds x="14" y="82" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
	</element>

	<!-- labels, white on the dark panel -->

	<element name="t_inte"><text string="INTE"><bounds x="0" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text><text string="INTE"><bounds x="0.02" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="t_prot"><text string="PROT"><bounds x="0" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text><text string="PROT"><bounds x="0.02" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="t_s7"><text string="MEMR"><bounds x="0" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text><text string="MEMR"><bounds x="0.02" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="t_s6"><text string="INP"><bounds x="0" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text><text string="INP"><bounds x="0.02" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="t_s5"><text string="M1"><bounds x="0" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text><text string="M1"><bounds x="0.02" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text></element>
	<element name="t_s4"><text string="OUT"><bounds x="0" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text><text string="OUT"><bounds x="0.02" y="0" width="1" height="1" /><color red="0.92" green="0.92" blue="0.90" /></text></element>
