	<element name="d_on"><text string="ON"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_off"><text string="OFF"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_power"><text string="POWER"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_stop"><text string="STOP"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_run"><text string="RUN"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_single_step"><text string="SINGLE  STEP"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_slow"><text string="SLOW"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_examine"><text string="EXAMINE"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_ex_next"><text string="EX NEXT"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_deposit"><text string="DEPOSIT"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_dep_next"><text string="DEP NEXT"><color red="0.13" green="0.13" blue="0.13" /></text></element>
