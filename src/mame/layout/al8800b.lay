	<element name="d_output"><text string="OUTPUT"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_accumulator"><text string="ACCUMULATOR"><color red="0.13" green="0.13" blue="0.13" /></text></element>

	<!--
	The name band's lettering is hollow: gold outlines with the black panel
	showing through. Layout text has no outline, so each word is drawn in gold
	at eight offsets round its centre, then once more in the panel's black.
	-->
	<element name="g_mits">
		<text string="mits"><bounds x="0.000" y="0.00" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.014" y="0.00" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.028" y="0.00" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.000" y="0.04" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.028" y="0.04" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.000" y="0.08" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.014" y="0.08" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.028" y="0.08" width="0.972" height="0.92" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="mits"><bounds x="0.014" y="0.04" width="0.972" height="0.92" /><color red="0.086" green="0.086" blue="0.086" /></text>
	</element>
	<element name="g_altair">
		<text string="altair 8800b"><bounds x="0.0000" y="0.000" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0035" y="0.000" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0070" y="0.000" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0000" y="0.035" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0070" y="0.035" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0000" y="0.070" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0035" y="0.070" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0070" y="0.070" width="0.993" height="0.93" /><color red="0.80" green="0.72" blue="0.42" /></text>
		<text string="altair 8800b"><bounds x="0.0035" y="0.035" width="0.993" height="0.93" /><color red="0.086" green="0.086" blue="0.086" /></text>
	</element>

	<group name="panel">
		<element ref="art"><bounds x="0" y="0" width="2875" height="1200" /></element>

		<!-- top row: PROTECT and INTE, the status LEDs in their box, the data LEDs -->
		<element name="3.1" ref="led"><bounds x="386" y="211" width="38" height="38" /></element>
		<element ref="l_protect"><bounds x="340" y="288" width="130" height="26" /></element>
		<element name="3.0" ref="led"><bounds x="486" y="211" width="38" height="38" /></element>
		<element ref="l_inte"><bounds x="465" y="288" width="80" height="26" /></element>
		<repeat count="8">
			<param name="n" start="7" increment="-1" />
			<param name="x" start="593" increment="101" />
			<param name="lx" start="572" increment="101" />
			<element name="2.~n~" ref="led"><bounds x="~x~" y="211" width="38" height="38" /></element>
		</repeat>
		<element ref="l_memr"><bounds x="572" y="288" width="80" height="26" /></element>
		<element ref="l_inp"><bounds x="673" y="288" width="80" height="26" /></element>
		<element ref="l_mi"><bounds x="774" y="288" width="80" height="26" /></element>
		<element ref="l_out"><bounds x="875" y="288" width="80" height="26" /></element>
		<element ref="l_hlta"><bounds x="976" y="288" width="80" height="26" /></element>
		<element ref="l_stack"><bounds x="1072" y="288" width="90" height="26" /></element>
		<element ref="l_wo"><bounds x="1178" y="288" width="80" height="26" /></element>
		<element ref="l_int"><bounds x="1279" y="288" width="80" height="26" /></element>
		<element ref="l_status"><bounds x="1440" y="322" width="120" height="18" /></element>

		<element name="1.7" ref="led"><bounds x="1656" y="211" width="38" height="38" /></element>
		<element name="1.6" ref="led"><bounds x="1757" y="211" width="38" height="38" /></element>
		<element name="1.5" ref="led"><bounds x="1907" y="211" width="38" height="38" /></element>
