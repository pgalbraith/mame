	<element name="d_d3"><text string="D3"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_d2"><text string="D2"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_d1"><text string="D1"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_d0"><text string="D0"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_data"><text string="DATA"><color red="0.13" green="0.13" blue="0.13" /></text></element>

	<element name="d_memory"><text string="MEMORY"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_io"><text string="I/O"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a15"><text string="A15"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a14"><text string="A14"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a13"><text string="A13"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a12"><text string="A12"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a11"><text string="A11"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a10"><text string="A10"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a9"><text string="A9"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a8"><text string="A8"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a7"><text string="A7"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a6"><text string="A6"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_a5"><text string="A5"><color red="0.13" green="0.13" blue="0.13" /></text></element>
