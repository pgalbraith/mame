<mamelayout version="2">

	<!--
	The MITS Altair 8800b front panel, drawn from a straight-on photograph of
	an 8800b and checked against Figure 2-1 of the MITS 8800b documentation
	(April 1977), which photographs the same panel.

	Everything is in the coordinates of the "art" element: 2875 by 1200, the
	blue frame included, with the black panel inside it from (42,42) to
	(2833,1155). Address columns are 101 apart inside an octal group and 150
	between groups, A15 at x=720 through A0 at x=2480; the data LEDs sit over
	A7-A0. Control switches are 205 apart, STOP/RUN at x=705. The static
	artwork is one SVG image; LEDs, switches and labels are drawn over it.

	LED outputs are named row.bit by the driver: row 0 address, row 1 data,
	row 2 the 8080 status latch, row 3 INTE/PROT/WAIT/HLDA. Their state is a
	brightness level, 0 (off) to 4 (full). lever0-lever7 are the control
	switch positions: 0 centre, 1 up, 2 down.
	-->

	<element name="art">
		<image><data><![CDATA[
			<?xml version="1.0" encoding="UTF-8" standalone="no"?>
			<svg xmlns:svg="http://www.w3.org/2000/svg" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 2875 1200" width="2875" height="1200">
				<defs>
					<linearGradient id="frame" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1200">
						<stop offset="0" stop-color="#5eb3e4" />
						<stop offset="1" stop-color="#3d93cc" />
					</linearGradient>
				</defs>

				<!-- frame and panel -->
				<rect x="0" y="0" width="2875" height="1200" fill="url(#frame)" />
				<rect x="0" y="0" width="2875" height="6" fill="#9bd2f2" />
				<rect x="34" y="34" width="2807" height="1129" fill="#2f78ad" />
				<rect x="42" y="42" width="2791" height="1113" fill="#161616" />

				<!-- the thin gold line round the working part of the panel -->
				<rect x="87" y="70" width="2700" height="910" fill="none" stroke="#b7a45a" stroke-width="5" />

				<!-- STATUS box, and the grey-blue DATA strip beside it -->
				<rect x="557" y="262" width="1050" height="88" rx="10" fill="none" stroke="#c9b464" stroke-width="5" />
				<rect x="1637" y="262" width="888" height="88" rx="10" fill="#6f8f9f" />
				<g stroke="#26343a" stroke-width="4">
					<path d="M 1851,274 V 320 M 2203,274 V 320" />
				</g>

				<!-- rings round the PROTECT and WAIT lamps -->
				<g fill="none" stroke="#9a9a96" stroke-width="5">
					<circle cx="405" cy="230" r="31" />
					<circle cx="412" cy="435" r="31" />
				</g>

				<!-- MEMORY / I/O address label strip -->
				<rect x="557" y="472" width="1968" height="90" rx="10" fill="#e3d9a0" />
				<g stroke="#2a2a2a" stroke-width="4">
					<path d="M 1851,486 V 522 M 2203,486 V 522" />
				</g>
				<g fill="none" stroke="#2a2a2a" stroke-width="3">
					<rect x="690" y="524" width="60" height="30" />
					<rect x="840" y="524" width="60" height="30" />
					<rect x="941" y="524" width="60" height="30" />
					<rect x="1042" y="524" width="60" height="30" />
					<rect x="1192" y="524" width="60" height="30" />
					<rect x="1293" y="524" width="60" height="30" />
					<rect x="1394" y="524" width="60" height="30" />
					<rect x="1544" y="524" width="60" height="30" />
				</g>

				<!-- SENSE switch strip, grey-blue behind A7-A0 -->
				<rect x="557" y="600" width="1968" height="85" rx="10" fill="#e3d9a0" />
				<rect x="1637" y="596" width="888" height="58" rx="8" fill="#6f8f9f" />

				<!-- control switch strip -->
				<rect x="157" y="748" width="2368" height="182" rx="14" fill="#e3d9a0" />
				<g fill="none" stroke="#2a2a2a" stroke-width="4">
					<!-- the line that runs round the controls and loops round STOP/RUN -->
					<path d="M 640,770 H 2477 V 915 H 787 L 731,873 M 640,770 V 847 H 669" />
					<circle cx="705" cy="847" r="36" />
					<circle cx="1730" cy="847" r="34" />
					<!-- ACCUMULATOR bracket, and the box round INPUT/OUTPUT -->
					<rect x="1862" y="790" width="355" height="110" rx="6" />
					<rect x="2085" y="815" width="110" height="65" />
				</g>
				<!-- gaps in the bracket where its labels sit -->
				<g fill="#e3d9a0">
					<rect x="1880" y="776" width="130" height="28" />
					<rect x="2090" y="776" width="90" height="28" />
					<rect x="1890" y="886" width="70" height="28" />
					<rect x="2095" y="886" width="100" height="28" />
				</g>

				<!-- MITS logo: a blue hexagon outline broken into three bars, with gaps at alternate corners -->
				<g fill="none" stroke="#3d93cc" stroke-width="22" stroke-linecap="round" stroke-linejoin="round">
					<path d="M 235,1028 L 262,1044 L 262,1076" />
					<path d="M 240,1115 L 212,1131 L 184,1115" />
					<path d="M 162,1076 L 162,1044 L 189,1028" />
				</g>
			</svg>
		]]></data></image>
	</element>

	<element name="hit" defstate="0"><rect><color alpha="0" /></rect></element>

	<!-- LEDs: red domes, near black when off -->

	<element name="led" defstate="0">
		<disk><color red="0.08" green="0.04" blue="0.04" /></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.22" green="0.05" blue="0.05" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.52" green="0.08" blue="0.07" /></disk>
		<disk state="2"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.70" green="0.11" blue="0.08" /></disk>
		<disk state="3"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.88" green="0.15" blue="0.10" /></disk>
		<disk state="4"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="1.00" green="0.24" blue="0.14" /></disk>
		<disk state="4"><bounds x="0.3" y="0.3" width="0.4" height="0.4" /><color red="1.00" green="0.55" blue="0.35" /></disk>
		<disk><bounds x="0.27" y="0.2" width="0.22" height="0.18" /><color red="1.0" green="1.0" blue="1.0" alpha="0.3" /></disk>
	</element>

	<!-- toggle switches: a black bushing with a short silver bat handle -->

	<element name="toggle" defstate="0">
		<rect><bounds x="0" y="0" width="44" height="120" /><color alpha="0" /></rect>
		<disk><bounds x="2" y="40" width="40" height="40" /><color red="0.07" green="0.07" blue="0.07" /></disk>
		<disk><bounds x="8" y="46" width="28" height="28" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect state="1"><bounds x="18" y="28" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="1"><bounds x="14" y="22" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<rect state="0"><bounds x="18" y="60" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="0"><bounds x="14" y="82" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
	</element>

	<!-- momentary control switches: 0 centre, 1 up, 2 down -->

	<element name="lever" defstate="0">
		<rect><bounds x="0" y="0" width="44" height="120" /><color alpha="0" /></rect>
		<disk><bounds x="2" y="40" width="40" height="40" /><color red="0.07" green="0.07" blue="0.07" /></disk>
		<disk><bounds x="8" y="46" width="28" height="28" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect state="1"><bounds x="18" y="28" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="1"><bounds x="14" y="22" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<rect state="2"><bounds x="18" y="60" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk state="2"><bounds x="14" y="82" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk state="0"><bounds x="13" y="51" width="18" height="18" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk state="1"><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
		<disk state="2"><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
	</element>

	<!-- the power switch is only drawn, turned on, which on the 8800b is up -->

	<element name="power">
		<rect><bounds x="0" y="0" width="44" height="120" /><color alpha="0" /></rect>
		<disk><bounds x="2" y="40" width="40" height="40" /><color red="0.07" green="0.07" blue="0.07" /></disk>
		<disk><bounds x="8" y="46" width="28" height="28" /><color red="0.20" green="0.20" blue="0.20" /></disk>
		<rect><bounds x="18" y="28" width="8" height="32" /><color red="0.74" green="0.74" blue="0.74" /></rect>
		<disk><bounds x="14" y="22" width="16" height="16" /><color red="0.92" green="0.92" blue="0.90" /></disk>
		<disk><bounds x="16" y="54" width="12" height="12" /><color red="0.62" green="0.62" blue="0.62" /></disk>
	</element>

	<!-- labels: light on the black panel, dark on the cream and grey-blue strips -->

	<element name="l_protect"><text string="PROTECT"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_inte"><text string="INTE"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_wait"><text string="WAIT"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_hlda"><text string="HLDA"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_memr"><text string="MEMR"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_inp"><text string="INP"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_mi"><text string="MI"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_out"><text string="OUT"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_hlta"><text string="HLTA"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_stack"><text string="STACK"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_wo"><text string="WO"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_int"><text string="INT"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="l_status"><text string="STATUS"><color red="0.90" green="0.90" blue="0.88" /></text></element>

	<element name="d_d7"><text string="D7"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_d6"><text string="D6"><color red="0.13" green="0.13" blue="0.13" /></text></element>
	<element name="d_d5"><text string="D5"><color red="0.13" green="0.13" blue="0.13" /></text></element>
