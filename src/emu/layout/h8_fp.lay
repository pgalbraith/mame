<?xml version="1.0"?>
<!--
license:CC0-1.0
-->
<mamelayout version="2">

	<!--
	The front of the H8 as it left the factory.  Positions, proportions and
	every key legend come from Figure 1-1 of the Front Panel Monitor PAM-8
	manual (595-2348), and the coordinates below are that figure's own, in
	pixels with the left end of the cabinet at zero, so a change can be checked
	against it directly.  The colours come from the photograph of the H8 in the
	Fall 1977 Heathkit catalog (number 817, page 4).
	-->

	<element name="cabinet"><rect><color red="0.07" green="0.07" blue="0.07" /></rect></element>
	<element name="cabinet_edge"><rect><color red="0.24" green="0.24" blue="0.23" /></rect></element>
	<element name="panel"><rect><color red="0.89" green="0.89" blue="0.86" /></rect></element>

	<!-- the bottom of the panel bends forward into a lip, lit from above -->
	<element name="lip">
		<rect><bounds x="0" y="0.00" width="1" height="0.12" /><color red="0.80" green="0.80" blue="0.77" /></rect>
		<rect><bounds x="0" y="0.12" width="1" height="0.22" /><color red="0.95" green="0.95" blue="0.92" /></rect>
		<rect><bounds x="0" y="0.34" width="1" height="0.26" /><color red="0.84" green="0.84" blue="0.81" /></rect>
		<rect><bounds x="0" y="0.60" width="1" height="0.22" /><color red="0.70" green="0.70" blue="0.67" /></rect>
		<rect><bounds x="0" y="0.82" width="1" height="0.18" /><color red="0.55" green="0.55" blue="0.53" /></rect>
	</element>

	<!-- the smoked red filter over the lamps and digits -->
	<element name="window_frame"><rect><color red="0.24" green="0.18" blue="0.18" /></rect></element>
	<element name="window"><rect><color red="0.07" green="0.05" blue="0.05" /></rect></element>

	<element name="digit">
		<led7seg><color red="1.0" green="0.12" blue="0.10" /></led7seg>
	</element>

	<!-- the lamp outputs are active low: 0 is lit -->
	<element name="lamp" defstate="1">
		<disk state="1"><color red="0.24" green="0.05" blue="0.05" /></disk>
		<disk state="0"><color red="1.0" green="0.16" blue="0.10" /></disk>
	</element>

	<element name="window_rule"><rect><color red="0.55" green="0.52" blue="0.50" /></rect></element>
	<element name="t_ion"><text string="ION" align="1"><color red="0.72" green="0.70" blue="0.68" /></text></element>
	<element name="t_mon"><text string="MON" align="1"><color red="0.72" green="0.70" blue="0.68" /></text></element>
	<element name="t_run"><text string="RUN" align="1"><color red="0.72" green="0.70" blue="0.68" /></text></element>
	<element name="t_pwr"><text string="PWR" align="1"><color red="0.72" green="0.70" blue="0.68" /></text></element>
	<element name="t_address"><text string="ADDRESS"><color red="0.72" green="0.70" blue="0.68" /></text></element>
	<element name="t_data"><text string="DATA/REGISTER"><color red="0.72" green="0.70" blue="0.68" /></text></element>

	<!--
	Keys: a big legend in the middle, the register the key calls in REG mode
	in the top left corner, and what it does outside the memory and register
	modes in the bottom right (PAM-8 manual, "H8 Keypad").  A pressed key's top
	lightens so a click can be seen.
	-->
	<element name="keypad_bezel"><rect><color red="0.04" green="0.04" blue="0.04" /></rect></element>

	<element name="key" defstate="0">
		<rect><color red="0.03" green="0.03" blue="0.03" /></rect>
		<rect state="0"><bounds x="0.07" y="0.05" width="0.86" height="0.80" /><color red="0.15" green="0.15" blue="0.15" /></rect>
		<rect state="1"><bounds x="0.07" y="0.05" width="0.86" height="0.80" /><color red="0.30" green="0.30" blue="0.30" /></rect>
	</element>

	<element name="k_0"><text string="Ø"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_1"><text string="1"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_2"><text string="2"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_3"><text string="3"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_4"><text string="4"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_5"><text string="5"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_6"><text string="6"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_7"><text string="7"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_8"><text string="8"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_9"><text string="9"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_plus"><text string="+"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_minus"><text string="-"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_star"><text string="*"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_hash"><text string="#"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_slash"><text string="/"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="k_dot"><disk><color red="0.95" green="0.95" blue="0.95" /></disk></element>

	<element name="s_sp"><text string="SP" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_af"><text string="AF" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_bc"><text string="BC" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_de"><text string="DE" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_hl"><text string="HL" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_pc"><text string="PC" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_reg"><text string="REG" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_mem"><text string="MEM" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="s_alter"><text string="ALTER" align="1"><color red="0.82" green="0.82" blue="0.82" /></text></element>

	<element name="f_si"><text string="SI" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_load"><text string="LOAD" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_dump"><text string="DUMP" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_go"><text string="GO" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_in"><text string="IN" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_out"><text string="OUT" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_cancel"><text string="CANCEL" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_rtm"><text string="RTM Ø" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>
	<element name="f_rst"><text string="RST Ø" align="2"><color red="0.82" green="0.82" blue="0.82" /></text></element>

	<!-- the nameplate: silver HEATHKIT on black, the model on an orange insert -->
	<element name="plate_frame"><rect><color red="0.42" green="0.42" blue="0.42" /></rect></element>
	<element name="plate"><rect><color red="0.12" green="0.12" blue="0.12" /></rect></element>
	<element name="plate_insert"><rect><color red="0.74" green="0.34" blue="0.24" /></rect></element>
	<element name="t_heathkit"><text string="H E A T H K I T"><color red="0.80" green="0.80" blue="0.79" /></text></element>
	<element name="t_h8"><text string="H8"><color red="0.08" green="0.08" blue="0.08" /></text></element>
	<element name="t_digital"><text string="DIGITAL"><color red="0.08" green="0.08" blue="0.08" /></text></element>
	<element name="t_computer"><text string="COMPUTER"><color red="0.08" green="0.08" blue="0.08" /></text></element>


	<!-- one key: the cap, clickable, with its legends over it -->
	<group name="key">
		<bounds x="0" y="0" width="76" height="72" />
		<element ref="key" inputtag="~port~" inputmask="~mask~"><bounds x="0" y="0" width="76" height="72" /></element>
		<element ref="~main~"><bounds x="21" y="17" width="34" height="28" /></element>
	</group>

	<group name="panel">
		<!-- cabinet sides and top, and the panel between them -->
		<element ref="cabinet"><bounds x="0" y="0" width="52" height="662" /></element>
		<element ref="cabinet"><bounds x="1670" y="0" width="52" height="662" /></element>
		<element ref="cabinet"><bounds x="52" y="0" width="1618" height="74" /></element>
		<element ref="cabinet_edge"><bounds x="52" y="74" width="1618" height="4" /></element>
		<element ref="panel"><bounds x="52" y="78" width="1618" height="449" /></element>
		<element ref="lip"><bounds x="52" y="527" width="1618" height="81" /></element>
		<element ref="cabinet"><bounds x="52" y="608" width="1618" height="54" /></element>

		<!-- display window -->
		<element ref="window_frame"><bounds x="103" y="132" width="809" height="148" /></element>
		<element ref="window"><bounds x="107" y="136" width="801" height="140" /></element>

		<element name="ion_led" ref="lamp"><bounds x="113" y="171" width="14" height="14" /></element>
		<element name="mon_led" ref="lamp"><bounds x="113" y="199" width="14" height="14" /></element>
		<element name="run_led" ref="lamp"><bounds x="113" y="226" width="14" height="14" /></element>
		<element name="pwr_led" ref="lamp"><bounds x="113" y="253" width="14" height="14" /></element>
		<element ref="t_ion"><bounds x="134" y="171" width="60" height="14" /></element>
		<element ref="t_mon"><bounds x="134" y="199" width="60" height="14" /></element>
		<element ref="t_run"><bounds x="134" y="226" width="60" height="14" /></element>
		<element ref="t_pwr"><bounds x="134" y="253" width="60" height="14" /></element>

		<!-- three groups of three digits: six of address, three of data -->
		<element name="digit1" ref="digit"><bounds x="251" y="146" width="42" height="74" /></element>
		<element name="digit2" ref="digit"><bounds x="300" y="146" width="42" height="74" /></element>
		<element name="digit3" ref="digit"><bounds x="350" y="146" width="42" height="74" /></element>
		<element name="digit4" ref="digit"><bounds x="486" y="146" width="42" height="74" /></element>
		<element name="digit5" ref="digit"><bounds x="535" y="146" width="42" height="74" /></element>
		<element name="digit6" ref="digit"><bounds x="585" y="146" width="42" height="74" /></element>
		<element name="digit7" ref="digit"><bounds x="723" y="146" width="42" height="74" /></element>
		<element name="digit8" ref="digit"><bounds x="772" y="146" width="42" height="74" /></element>
		<element name="digit9" ref="digit"><bounds x="822" y="146" width="42" height="74" /></element>

		<element ref="window_rule"><bounds x="230" y="262" width="157" height="2" /></element>
		<element ref="t_address"><bounds x="392" y="255" width="90" height="15" /></element>
		<element ref="window_rule"><bounds x="487" y="262" width="156" height="2" /></element>
		<element ref="window_rule"><bounds x="697" y="262" width="31" height="2" /></element>
		<element ref="t_data"><bounds x="733" y="255" width="124" height="15" /></element>
		<element ref="window_rule"><bounds x="862" y="262" width="28" height="2" /></element>

		<!-- nameplate -->
		<element ref="plate_frame"><bounds x="195" y="407" width="432" height="70" /></element>
		<element ref="plate"><bounds x="199" y="411" width="424" height="62" /></element>
		<element ref="t_heathkit"><bounds x="212" y="428" width="220" height="28" /></element>
		<element ref="plate_insert"><bounds x="440" y="414" width="176" height="56" /></element>
		<element ref="t_h8"><bounds x="447" y="424" width="42" height="36" /></element>
		<element ref="t_digital"><bounds x="494" y="423" width="116" height="17" /></element>
		<element ref="t_computer"><bounds x="494" y="443" width="116" height="17" /></element>

		<!-- keypad, in the order Figure 1-1 shows it -->
		<element ref="keypad_bezel"><bounds x="1137" y="132" width="329" height="316" /></element>

		<param name="port" value="X0" /><param name="mask" value="0x80" /><param name="main" value="k_7" />
		<group ref="key"><bounds x="1145" y="140" width="76" height="72" /></group>
		<element ref="f_si"><bounds x="1170" y="186" width="44" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x01" /><param name="main" value="k_8" />
		<group ref="key"><bounds x="1224" y="140" width="76" height="72" /></group>
		<element ref="f_load"><bounds x="1249" y="186" width="44" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x02" /><param name="main" value="k_9" />
		<group ref="key"><bounds x="1303" y="140" width="76" height="72" /></group>
		<element ref="f_dump"><bounds x="1328" y="186" width="44" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x04" /><param name="main" value="k_plus" />
		<group ref="key"><bounds x="1382" y="140" width="76" height="72" /></group>

		<param name="port" value="X0" /><param name="mask" value="0x10" /><param name="main" value="k_4" />
		<group ref="key"><bounds x="1145" y="216" width="76" height="72" /></group>
		<element ref="s_de"><bounds x="1153" y="222" width="40" height="12" /></element>
		<element ref="f_go"><bounds x="1170" y="262" width="44" height="12" /></element>
		<param name="port" value="X0" /><param name="mask" value="0x20" /><param name="main" value="k_5" />
		<group ref="key"><bounds x="1224" y="216" width="76" height="72" /></group>
		<element ref="s_hl"><bounds x="1232" y="222" width="40" height="12" /></element>
		<element ref="f_in"><bounds x="1249" y="262" width="44" height="12" /></element>
		<param name="port" value="X0" /><param name="mask" value="0x40" /><param name="main" value="k_6" />
		<group ref="key"><bounds x="1303" y="216" width="76" height="72" /></group>
		<element ref="s_pc"><bounds x="1311" y="222" width="40" height="12" /></element>
		<element ref="f_out"><bounds x="1328" y="262" width="44" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x08" /><param name="main" value="k_minus" />
		<group ref="key"><bounds x="1382" y="216" width="76" height="72" /></group>

		<param name="port" value="X0" /><param name="mask" value="0x02" /><param name="main" value="k_1" />
		<group ref="key"><bounds x="1145" y="292" width="76" height="72" /></group>
		<element ref="s_sp"><bounds x="1153" y="298" width="40" height="12" /></element>
		<param name="port" value="X0" /><param name="mask" value="0x04" /><param name="main" value="k_2" />
		<group ref="key"><bounds x="1224" y="292" width="76" height="72" /></group>
		<element ref="s_af"><bounds x="1232" y="298" width="40" height="12" /></element>
		<param name="port" value="X0" /><param name="mask" value="0x08" /><param name="main" value="k_3" />
		<group ref="key"><bounds x="1303" y="292" width="76" height="72" /></group>
		<element ref="s_bc"><bounds x="1311" y="298" width="40" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x10" /><param name="main" value="k_star" />
		<group ref="key"><bounds x="1382" y="292" width="76" height="72" /></group>
		<element ref="f_cancel"><bounds x="1397" y="338" width="54" height="12" /></element>

		<param name="port" value="X0" /><param name="mask" value="0x01" /><param name="main" value="k_0" />
		<group ref="key"><bounds x="1145" y="368" width="76" height="72" /></group>
		<element ref="key" inputtag="X1" inputmask="0x80"><bounds x="1224" y="368" width="76" height="72" /></element>
		<element ref="k_dot"><bounds x="1256" y="398" width="10" height="10" /></element>
		<element ref="s_reg"><bounds x="1232" y="374" width="40" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x40" /><param name="main" value="k_hash" />
		<group ref="key"><bounds x="1303" y="368" width="76" height="72" /></group>
		<element ref="s_mem"><bounds x="1311" y="374" width="40" height="12" /></element>
		<element ref="f_rtm"><bounds x="1318" y="414" width="54" height="12" /></element>
		<param name="port" value="X1" /><param name="mask" value="0x20" /><param name="main" value="k_slash" />
		<group ref="key"><bounds x="1382" y="368" width="76" height="72" /></group>
		<element ref="s_alter"><bounds x="1390" y="374" width="44" height="12" /></element>
		<element ref="f_rst"><bounds x="1397" y="414" width="54" height="12" /></element>
	</group>


	<view name="Front Panel">
		<group ref="panel"><bounds x="0" y="0" width="1722" height="662" /></group>
	</view>

	<view name="Front Panel and Terminal">
		<group ref="panel"><bounds x="0" y="0" width="1722" height="662" /></group>
		<screen index="0"><bounds x="291" y="702" width="1140" height="855" /></screen>
	</view>

</mamelayout>
