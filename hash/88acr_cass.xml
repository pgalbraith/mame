<softwarelist name="88acr_cass" description="MITS Altair 88-ACR cassettes">

	<!--
	These tapes boot from the cassette bootstrap loader toggled in at 000000,
	with sense switches A9 and A8 up and the rest down, which tells the
	checksum loader on the tape to read from the 88-ACR. Deposit the loader,
	set the switches, start the tape, EXAMINE 000000 and RUN. BASIC loads
	from the top of memory down, and then reads its terminal from the sense
	switches; with them as left, the console is an 88-2SIO at 020 octal.
	-->

	<!-- https://deramp.com/downloads/altair/software/papertape_cassette/4K%20BASIC%20Ver%204-0.tap -->
	<software name="bas4k">
		<description>Altair 4K BASIC 4.0</description>
		<year>1976</year>
		<publisher>MITS</publisher>
		<info name="developer" value="Microsoft"/>
		<info name="version" value="4.0"/>
		<info name="usage" value="Bootstrap loader in octal at 000000: 041 302 017 061 022 000 333 006 017 330 333 007 275 310 055 167 300 351 003 000. Sense switches A9 and A8 up. Loads in about 2 1/2 minutes; answer MEMORY SIZE and TERMINAL WIDTH with RETURN and SIN with Y"/>

		<part name="cass" interface="88acr_cass">
			<dataarea name="cass" size="4352">
				<rom name="4k_basic_4_0.tap" size="4352" crc="f0f985df" sha1="7e1fdc4be0563988575efcb85f182d7e11900b19"/>
			</dataarea>
		</part>
	</software>

